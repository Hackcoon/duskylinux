    },
    "@context:elevated": {
      "text": {
        "action": {
          "primary": {
            "default": "{{colors.on_surface.default.hex}}"
          }
        }
      },
      "background": {
        "default": "{{colors.surface_container_high.default.hex}}",
        "action": {
          "primary": {
            "default": "{{colors.primary.default.hex}}",
            "$hovered": "{{colors.primary_container.default.hex}}"
          }
        }
      }
    },
    "@context:overlay": {
      "text": {
        "action": {
          "primary": {
            "default": "{{colors.on_surface.default.hex}}"
          }
        }
      },
      "background": {
        "default": "{{colors.surface_container_highest.default.hex}}",
        "action": {
          "primary": {
            "default": "{{colors.primary.default.hex}}",
            "$hovered": "{{colors.primary_container.default.hex}}"
          }
        }
      }
    }
  }
}
